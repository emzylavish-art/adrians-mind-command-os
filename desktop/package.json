{
  "name": "adrians-mind",
  "productName": "Adrian's Mind",
  "version": "0.9.1",
  "private": true,
  "main": "main.cjs",
  "description": "Adrian's Mind on Windows. The package contains the product, including Build. It does not include a separate Kimi program.",
  "author": "emzylavish-art",
  "build": {
    "appId": "art.emzylavish.adrians-mind",
    "productName": "Adrian's Mind",
    "asar": true,
    "files": [
      "main.cjs",
      "cloud-update.cjs",
      "dictation-companion.cjs",
      "dictation-widget.html",
      {
        "from": "../public/desktop-update.json",
        "to": "desktop-update.json"
      },
      "update-contract.cjs",
      "update-download.cjs",
      "installer-auth.cjs",
      "runtime-contract.cjs",
      "publisher-trust.json",
      "platform-capabilities.json",
      "native-network.cjs",
      "runtime-build.json"
    ],
    "extraResources": [
      {
        "from": "app-server",
        "to": "app-server"
      },
      {
        "from": "engines",
        "to": "engines"
      },
      {
        "from": "../agent/windows",
        "to": "companion"
      },
      {
        "from": "models/jeff",
        "to": "models/jeff"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AdriansMind-Setup-Full.${ext}",
      "shortcutName": "Adrian's Mind",
      "uninstallDisplayName": "Adrian's Mind"
    },
    "directories": {
      "output": "dist"
    },
    "afterPack": "./check-windows-resources.cjs",
    "beforePack": "./check-build-identity.cjs",
    "forceCodeSigning": true
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
