{
  "schema_version": "1.0.0",
  "target": "Windows 11",
  "install_root": "%USERPROFILE%\\AdriansMind",
  "repositories": [
    {
      "id": "everything-claude-code",
      "name": "Everything Claude Code",
      "url": "https://github.com/affaan-m/ECC.git",
      "install_kind": "source-checkout"
    },
    {
      "id": "superpowers",
      "name": "Superpowers",
      "url": "https://github.com/obra/superpowers.git",
      "install_kind": "source-checkout"
    },
    {
      "id": "gsd-core",
      "name": "GSD Core",
      "url": "https://github.com/gsd-build/get-shit-done.git",
      "install_kind": "source-checkout"
    },
    {
      "id": "ui-ux-pro-max",
      "name": "UI UX Pro Max",
      "url": "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill.git",
      "install_kind": "source-and-npm-cli",
      "npm_package": "ui-ux-pro-max-cli"
    },
    {
      "id": "n8n-mcp",
      "name": "n8n-MCP",
      "url": "https://github.com/czlonkowski/n8n-mcp.git",
      "install_kind": "source-and-npm-cli",
      "npm_package": "n8n-mcp"
    },
    {
      "id": "lightrag",
      "name": "LightRAG",
      "url": "https://github.com/HKUDS/LightRAG.git",
      "install_kind": "source-and-python-package",
      "python_package": "lightrag-hku[api]"
    },
    {
      "id": "claude-mem",
      "name": "Claude Mem",
      "url": "https://github.com/thedotmack/claude-mem.git",
      "install_kind": "source-checkout",
      "note": "Plugin activation and provider configuration are not performed automatically."
    },
    {
      "id": "obsidian-skills",
      "name": "Obsidian Skills",
      "url": "https://github.com/kepano/obsidian-skills.git",
      "install_kind": "source-checkout"
    },
    {
      "id": "awesome-claude-code",
      "name": "Awesome Claude Code",
      "url": "https://github.com/subinium/awesome-claude-code.git",
      "install_kind": "reference-catalog"
    },
    {
      "id": "ghidra",
      "name": "Ghidra",
      "url": "https://github.com/NationalSecurityAgency/ghidra.git",
      "install_kind": "source-and-latest-release-archive",
      "release_asset_regex": "^ghidra_.*\\.zip$",
      "requires": "64-bit JDK 25"
    },
    {
      "id": "jadx",
      "name": "JADX",
      "url": "https://github.com/skylot/jadx.git",
      "install_kind": "source-and-latest-release-archive",
      "release_asset_regex": "^jadx.*\\.zip$",
      "requires": "64-bit Java runtime"
    },
    {
      "id": "frida",
      "name": "Frida",
      "url": "https://github.com/frida/frida.git",
      "install_kind": "source-and-python-package",
      "python_package": "frida-tools"
    },
    {
      "id": "owasp-zap",
      "name": "OWASP ZAP",
      "url": "https://github.com/zaproxy/zaproxy.git",
      "install_kind": "source-and-winget",
      "winget_id": "ZAP.ZAP"
    },
    {
      "id": "gdb",
      "name": "GDB",
      "url": "https://github.com/gnutools/binutils-gdb.git",
      "install_kind": "source-and-msys2-package",
      "msys2_package": "mingw-w64-ucrt-x86_64-gdb",
      "note": "GitHub mirror pinned as a submodule; MSYS2 package is the installable Windows runtime."
    },
    {
      "id": "x64dbg",
      "name": "x64dbg",
      "url": "https://github.com/x64dbg/x64dbg.git",
      "install_kind": "source-and-latest-release-archive",
      "release_asset_regex": "(?i).*\\.zip$"
    },
    {
      "id": "burp-suite",
      "name": "Burp Suite Community Edition",
      "url": "https://portswigger.net/burp/communitydownload",
      "install_kind": "official-winget-package",
      "winget_id": "PortSwigger.BurpSuite.Community",
      "note": "Community edition only; PortSwigger's license terms apply."
    },
    {
      "id": "l1b3rt4s",
      "name": "L1B3RT4S",
      "url": "https://github.com/elder-plinius/L1B3RT4S.git",
      "install_kind": "source-checkout",
      "note": "Prompt-injection/LLM red-team research corpus. Source checkout only; do not automatically execute attacks or bypass service safeguards."
    },
    {
      "id": "pipecat",
      "name": "Pipecat",
      "url": "https://github.com/pipecat-ai/pipecat.git",
      "install_kind": "source-checkout",
      "pinned_commit": "de8998789d5690073ddd1dafcec7268839af8153",
      "note": "Voice pipeline pin. Checkout only. Do not start a live session from the bootstrap."
    },
    {
      "id": "whisper-loop",
      "name": "whisper-loop",
      "url": "https://github.com/aryeo0908/whisper-loop.git",
      "install_kind": "source-checkout",
      "pinned_commit": "810e1d5d410557038d1379cd709e3fb979422bde",
      "note": "Streaming STT/LLM/TTS loop with barge-in. Checkout only."
    },
    {
      "id": "voice-agent-starter",
      "name": "voice-agent-starter",
      "url": "https://github.com/livekit-examples/agent-starter-python.git",
      "install_kind": "source-checkout",
      "pinned_commit": "228095c442fcb259c80e9786fc0d7c5534e6af46",
      "note": "LiveKit Agents Python starter used as the latency-stage reference. Checkout only."
    },
    {
      "id": "api-health",
      "name": "api-health",
      "url": "https://github.com/lxgicstudios/api-health.git",
      "install_kind": "source-checkout",
      "pinned_commit": "4376ac6091ba93d9cce6f614a50861b99d689150",
      "note": "Zero-dependency Node health CLI. Run from the pin. Do not npm-publish."
    },
    {
      "id": "healthy-api",
      "name": "healthy-api",
      "url": "https://github.com/mosishon/healthy-api.git",
      "install_kind": "source-checkout",
      "pinned_commit": "23fbfbb444f41c7f9bcfdc4a3a6958487baddbe8",
      "note": "Go concurrent health checker. Checkout only. Do not commit a filled config.yaml."
    },
    {
      "id": "omniprobe",
      "name": "OmniProbe",
      "url": "https://github.com/ssrsgaga/API-Check.git",
      "install_kind": "source-checkout",
      "pinned_commit": "292a011be478a3fdb348dd672c75d6bc0a6f114d",
      "note": "Pure-frontend LLM connectivity tester, including function calling. Do not copy upstream .env.local."
    },
    {
      "id": "coval-benchmarks",
      "name": "Coval benchmarks",
      "url": "https://github.com/coval-ai/benchmarks.git",
      "install_kind": "source-checkout",
      "pinned_commit": "7b4e5583fb720f503c467222c2ff447e48138a50",
      "note": "Voice latency and accuracy benchmarks. Public leaderboard needs no key. Do not commit .env."
    }
  ],
  "not_auto_integrated": [
    {
      "id": "blackeye",
      "reason": "Phishing and credential-harvesting functionality is excluded."
    },
    {
      "id": "gods-eyes",
      "reason": "Exact project identity and official source have not been established."
    },
    {
      "id": "arrow-ea",
      "reason": "Exact product identity and official source have not been established."
    }
  ]
}
