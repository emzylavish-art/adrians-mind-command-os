{
  "schema_version": "1.0.0",
  "name": "Mind Command OS Agent Team",
  "description": "Interoperable specialist agents and callable tools for compatible AI runners. Includes an explicitly configured, HTTPS-only remote MCP bridge for AI-host integrations.",
  "entrypoint_contract": {
    "protocol": "json-stdin-json-stdout",
    "required_input": [
      "task"
    ],
    "required_output": [
      "status",
      "result",
      "evidence",
      "limitations"
    ],
    "statuses": [
      "ready",
      "partial",
      "blocked",
      "not_implemented"
    ]
  },
  "routing_policy": {
    "match": "capabilities",
    "prefer": "ready",
    "allow_partial": true,
    "partial_requires_disclosure": true,
    "no_claim_without_execution_evidence": true
  },
  "agents": [
    {
      "id": "orchestrator",
      "role": "Orchestrator",
      "capabilities": [
        "task_classification",
        "planning",
        "dispatch",
        "synthesis",
        "durable_task_queue"
      ],
      "status": "contract_defined",
      "entrypoint": "team/agents/orchestrator.md",
      "requires": []
    },
    {
      "id": "analysis",
      "role": "Analysis Specialist",
      "capabilities": [
        "reasoning",
        "requirements_analysis",
        "document_analysis"
      ],
      "status": "contract_defined",
      "entrypoint": "team/agents/analysis.md",
      "requires": []
    },
    {
      "id": "research",
      "role": "Research Specialist",
      "capabilities": [
        "source_research",
        "evidence_collection",
        "citation"
      ],
      "status": "adapter_required",
      "entrypoint": "team/agents/research.md",
      "requires": [
        "configured_search_provider"
      ]
    },
    {
      "id": "engineering",
      "role": "Engineering / Codex Specialist",
      "capabilities": [
        "coding",
        "refactoring",
        "implementation",
        "tests",
        "ci"
      ],
      "status": "contract_defined",
      "entrypoint": "team/agents/engineering.md",
      "requires": [
        "repository_access"
      ]
    },
    {
      "id": "rea",
      "role": "Reverse Engineering Specialist",
      "capabilities": [
        "source_inventory",
        "static_recon",
        "manifest_discovery"
      ],
      "status": "ready",
      "entrypoint": "tools/rea/rea.py",
      "requires": [
        "python3"
      ]
    },
    {
      "id": "security",
      "role": "Defensive Security Specialist",
      "capabilities": [
        "secure_code_review",
        "dependency_review",
        "static_security_triage"
      ],
      "status": "partial",
      "entrypoint": "tools/security_review/security_review.py",
      "requires": [
        "human_review_of_heuristic_findings",
        "approved_scope"
      ]
    },
    {
      "id": "gods-eyes",
      "role": "God's Eyes",
      "capabilities": [
        "capability_name_reserved"
      ],
      "status": "source_unmapped",
      "entrypoint": null,
      "requires": [
        "identify_exact_project_and_source"
      ]
    },
    {
      "id": "knowledge",
      "role": "Memory / Knowledge Specialist",
      "capabilities": [
        "context_retrieval",
        "knowledge_organization"
      ],
      "status": "partial",
      "entrypoint": "tools/knowledge/knowledge_search.py",
      "requires": [
        "local_knowledge_path"
      ]
    },
    {
      "id": "browser-workflow",
      "role": "Browser / Workflow Specialist",
      "capabilities": [
        "browser_workflows",
        "web_task_automation"
      ],
      "status": "adapter_required",
      "entrypoint": "team/agents/browser-workflow.md",
      "requires": [
        "authorized_browser_runtime",
        "connector_configuration"
      ]
    },
    {
      "id": "qa-release",
      "role": "QA / Release Specialist",
      "capabilities": [
        "test_execution",
        "validation",
        "release_readiness"
      ],
      "status": "partial",
      "entrypoint": "team/agents/qa-release.md",
      "requires": [
        "test_runner",
        "repository_access"
      ]
    },
    {
      "id": "observability",
      "role": "Observability Specialist",
      "capabilities": [
        "run_status",
        "structured_logs",
        "health_checks"
      ],
      "status": "partial",
      "entrypoint": "team/health.py",
      "requires": [
        "python3"
      ]
    },
    {
      "id": "human-approval",
      "role": "Human Approval Gate",
      "capabilities": [
        "approval_for_external_actions"
      ],
      "status": "contract_defined",
      "entrypoint": "team/agents/human-approval.md",
      "requires": [
        "approval_channel"
      ]
    },
    {
      "id": "worker-runtime",
      "role": "Durable Worker Runtime",
      "capabilities": [
        "queue_management",
        "durable_worker_jobs"
      ],
      "status": "partial",
      "entrypoint": "team/worker.py",
      "requires": [
        "python3",
        "local_sqlite_database",
        "explicit_worker_process"
      ]
    }
  ],
  "tools": [
    {
      "id": "rea.scan",
      "agent": "rea",
      "capabilities": [
        "source_inventory",
        "static_recon"
      ],
      "status": "ready",
      "entrypoint": "python3 tools/rea/rea.py",
      "input_schema": {
        "path": "string",
        "json": "boolean",
        "out": "string"
      },
      "safety": "offline; does not execute scanned code"
    },
    {
      "id": "gods-eyes",
      "agent": "gods-eyes",
      "capabilities": [
        "capability_name_reserved"
      ],
      "status": "source_unmapped",
      "entrypoint": null,
      "input_schema": null,
      "safety": "Do not fabricate source or executable behavior"
    },
    {
      "id": "blackeye",
      "agent": "security",
      "capabilities": [
        "security_tool_reference"
      ],
      "status": "restricted_not_integrated",
      "entrypoint": null,
      "input_schema": null,
      "safety": "Do not integrate credential-harvesting or phishing workflows"
    },
    {
      "id": "security.scan",
      "agent": "security",
      "capabilities": [
        "secure_code_review",
        "static_security_triage"
      ],
      "status": "ready",
      "entrypoint": "python3 tools/security_review/security_review.py",
      "input_schema": {
        "path": "string",
        "json": "boolean",
        "out": "string"
      },
      "safety": "offline heuristic static review; no code execution or network requests; authorized source only"
    },
    {
      "id": "team.health",
      "agent": "observability",
      "capabilities": [
        "run_status",
        "health_checks"
      ],
      "status": "ready",
      "entrypoint": "python3 team/health.py",
      "input_schema": {
        "json": "boolean"
      },
      "safety": "offline repository readiness report; no secrets, external calls, or provider probes"
    },
    {
      "id": "knowledge.search",
      "agent": "knowledge",
      "capabilities": [
        "context_retrieval",
        "knowledge_organization"
      ],
      "status": "ready",
      "entrypoint": "python3 tools/knowledge/knowledge_search.py",
      "input_schema": {
        "path": "string",
        "query": "string",
        "top_k": "integer"
      },
      "safety": "offline lexical search over local Markdown/text files; no external service"
    },
    {
      "id": "team.queue",
      "agent": "worker-runtime",
      "capabilities": [
        "queue_management",
        "durable_worker_jobs"
      ],
      "status": "ready",
      "entrypoint": "python3 team/queue.py",
      "input_schema": {
        "action": "enqueue|claim|complete|fail|list",
        "task": "string",
        "payload": "object",
        "worker": "string",
        "id": "string",
        "result": "object",
        "error": "string",
        "db": "string"
      },
      "safety": "SQLite local queue; stores payloads only and never executes queued task data; worker must apply policy and approvals."
    },
    {
      "id": "team.worker",
      "agent": "worker-runtime",
      "capabilities": [
        "durable_worker_execution",
        "allowlisted_task_processing"
      ],
      "status": "ready",
      "entrypoint": "python3 team/worker.py",
      "input_schema": {
        "worker_id": "string",
        "db": "string",
        "lease_seconds": "integer",
        "timeout_seconds": "integer"
      },
      "safety": "One-shot queue consumer; dispatches only allowlisted local tools; rejects arbitrary commands and code payloads."
    },
    {
      "id": "team.agent.resolve",
      "agent": "orchestrator",
      "capabilities": [
        "agent_prompt_resolution",
        "dispatch"
      ],
      "status": "ready",
      "entrypoint": "python3 team/runner.py",
      "input_schema": {
        "agent_id": "string",
        "task": "string",
        "capabilities": "string[]",
        "context": "object"
      },
      "safety": "Reads verified agent prompt files only; does not execute model inference or external actions."
    },
    {
      "id": "mcp.remote",
      "status": "ready",
      "entrypoint": "python3 team/remote_mcp.py",
      "agent": "engineering",
      "capabilities": [
        "remote_mcp_discovery",
        "allowlisted_remote_tool_invocation"
      ],
      "input_schema": {
        "action": "list|call",
        "server": "string",
        "tool": "string",
        "arguments": "object",
        "timeout_seconds": "integer"
      },
      "safety": "HTTPS only; server must be explicitly enabled and remote tool must be allowlisted. Bearer secrets are environment-only. No endpoints are enabled by default."
    }
  ],
