FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8080

WORKDIR /app
COPY . /app

RUN useradd --system --uid 10001 mcpuser \
    && mkdir -p /app/team \
    && chown -R mcpuser:mcpuser /app

USER mcpuser
EXPOSE 8080

CMD ["python", "team/mcp_http.py"]
