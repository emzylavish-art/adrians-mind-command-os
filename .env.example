# Server-only. Never commit real values.
# Preferred on this box: /home/box/.secrets/xai_inference.env
#   export XAI_API_KEY=xai-...
XAI_API_KEY=
# Management key is separate and must not be used for chat.
# XAI_MANAGEMENT_KEY=

# Model tier → concrete xAI model ids (optional overrides).
# Defaults match ids listed by GET https://api.x.ai/v1/models during xAI verification.
# MIND_MODEL_FAST=grok-4.20-0309-non-reasoning
# MIND_MODEL_EXPERT=grok-4.5
# MIND_MODEL_HEAVY=grok-4.7
# MIND_MODEL_BUILD=grok-build-0.1

# Notion integration token (optional fallback for MCP tools; not OAuth)
# NOTION_TOKEN=
# NOTION_API_KEY=

# Notion OAuth (ServiceBoard Connect)
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/notion/callback
# Optional overrides:
# NOTION_OAUTH_AUTHORIZE_URL=https://api.notion.com/v1/oauth/authorize
# NOTION_OAUTH_TOKEN_URL=https://api.notion.com/v1/oauth/token
# NOTION_OAUTH_REVOKE_URL=

# Encrypt connector tokens at rest (recommended). If unset, an ephemeral process key is used.
# CONNECTOR_TOKEN_SECRET=

# Paired PC agent (optional; MCP pc_run_shell)
# MIND_PC_AGENT_URL=
# MIND_PC_AGENT_TOKEN=

# Web research (optional). Both must be set or Research refuses with no citations.
# POST JSON { "query": "..." } with Authorization: Bearer <key>
# Response JSON { "results": [ { "title": "...", "url": "https://..." } ] }
# MIND_SEARCH_ENDPOINT=
# MIND_SEARCH_KEY=

# PC pairing (MCP pc_run_shell). Agent registers then polls; no shell on the app host.
# MIND_PC_PAIRING_SECRET=
# Legacy push agent (optional):
# MIND_PC_AGENT_URL=
# MIND_PC_AGENT_TOKEN=

# --- Google OAuth (one client; per-service redirect + scopes for Gmail / Calendar / Drive) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/google_drive/callback
# GOOGLE_OAUTH_GMAIL_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/gmail/callback
# GOOGLE_OAUTH_CALENDAR_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/google_calendar/callback
# GOOGLE_OAUTH_DRIVE_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/google_drive/callback
# GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke

# --- Storage account refresh (server-side; never commit real values) ---
# Prefer encrypted StoredConnection records (.data/mind-connectors/...).
# Optional env refresh tokens (not access tokens):
# MIND_GOOGLE_DRIVE_REFRESH_TOKEN=
# MIND_DROPBOX_REFRESH_TOKEN=
# MIND_ONEDRIVE_REFRESH_TOKEN=
# Break-glass plain *access* tokens (short-lived; prefer refresh above):
# MIND_GOOGLE_DRIVE_TOKEN=
# MIND_DROPBOX_TOKEN=
# MIND_ONEDRIVE_TOKEN=
# MIND_PCLOUD_TOKEN=
# MIND_PCLOUD_API_HOST=api.pcloud.com
#
# Optional per-lane break-glass tokens (Media Storage Fleet lane ids). Prefer
# encrypted StoredConnection records under .data/mind-connectors/<sha256(credentialOwnerId)>/.
# Env name = MIND_STORAGE_LANE_<LANE_ID_UPPER_UNDERSCORES>_(TOKEN|REFRESH_TOKEN)
# Example lane ids: gdrive-emmanuelohilebo4, onedrive-emmanuelohilebo4
# MIND_STORAGE_LANE_GDRIVE_EMMANUELOHILEBO4_REFRESH_TOKEN=
# MIND_STORAGE_LANE_ONEDRIVE_EMMANUELOHILEBO4_REFRESH_TOKEN=

# --- Dropbox OAuth (storage + future ServiceBoard) ---
# DROPBOX_OAUTH_CLIENT_ID=
# DROPBOX_OAUTH_CLIENT_SECRET=
# DROPBOX_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/dropbox/callback
# DROPBOX_OAUTH_AUTHORIZE_URL=https://www.dropbox.com/oauth2/authorize
# DROPBOX_OAUTH_TOKEN_URL=https://api.dropboxapi.com/oauth2/token
# DROPBOX_OAUTH_REVOKE_URL=https://api.dropboxapi.com/2/auth/token/revoke

# --- Microsoft / OneDrive OAuth ---
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/onedrive/callback
# MICROSOFT_OAUTH_AUTHORIZE_URL=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
# MICROSOFT_OAUTH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token

# --- Slack OAuth ---
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/slack/callback
# SLACK_OAUTH_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
# SLACK_OAUTH_TOKEN_URL=https://slack.com/api/oauth.v2.access
# SLACK_OAUTH_REVOKE_URL=https://slack.com/api/auth.revoke

# --- GitHub OAuth ---
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/github/callback
# GITHUB_OAUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# GITHUB_OAUTH_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_OAUTH_REVOKE_URL=
# Turn / agent timeouts (ms). Defaults: chat 30000, agent 45000. See docs/timeouts.md.
# MIND_CHAT_TIMEOUT_MS=30000
# MIND_AGENT_TIMEOUT_MS=45000

# Search timeouts (ms). Defaults: per-query 15000, deep overall 45000. See docs/timeouts.md.
# MIND_SEARCH_TIMEOUT_MS=15000
# MIND_SEARCH_DEEP_TIMEOUT_MS=45000


# Stdio (command) MCP servers. Registration alone never runs anything: a child is
# spawned only if its exact command string is on this operator allowlist
# (separate with ";" "," or newlines). Empty/unset = no stdio server can run.
# WARNING: allowlisting an interpreter (node, python, npx, sh) lets any signed-in
# user run arbitrary code on this host via args. Prefer absolute paths to
# dedicated MCP server binaries.
MIND_MCP_STDIO_ALLOW=
# MIND_MCP_STDIO_CONNECT_TIMEOUT_MS=10000
# MIND_MCP_STDIO_CALL_TIMEOUT_MS=30000

# Supabase Auth (server-only — do not prefix with VITE_)
# Connect the Supabase integration on the Vercel project, or set these manually.
# Never commit real values. Never put the service-role key here or in client code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated Supabase Auth OAuth providers enabled in the project (google,github,apple).
# Default empty = OAuth buttons stay visible but disabled with "Not enabled yet".
# SUPABASE_OAUTH_PROVIDERS=

# Also accepted (Vercel–Supabase integration aliases), still read server-side only:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Owner broker sign-in (Google / X via Better Auth) — names only; never commit values.
# VITE_AUTH_ENABLED=true
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
# DATABASE_URL=


# --- pCloud (long-lived access token; no refresh) ---
# MIND_PCLOUD_TOKEN=
# MIND_PCLOUD_API_HOST=api.pcloud.com
