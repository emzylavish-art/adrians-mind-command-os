# Server-only. Never commit real values.

# xAI chat (optional)
# XAI_API_KEY=

# Notion integration token (optional fallback for MCP tools; not OAuth)
# NOTION_TOKEN=
# NOTION_API_KEY=

# Notion OAuth (ServiceBoard Connect)
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# NOTION_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/mind/oauth/notion/callback
# Optional overrides:
# NOTION_OAUTH_AUTHORIZE_URL=https://api.notion.com/v1/oauth/authorize
# NOTION_OAUTH_TOKEN_URL=https://api.notion.com/v1/oauth/token
# NOTION_OAUTH_REVOKE_URL=

# Encrypt connector tokens at rest (recommended). If unset, an ephemeral process key is used.
# CONNECTOR_TOKEN_SECRET=

# Paired PC agent (optional; MCP pc_run_shell)
# MIND_PC_AGENT_URL=
# MIND_PC_AGENT_TOKEN=

# Web research (optional)
# MIND_SEARCH_ENDPOINT=
# MIND_SEARCH_KEY=

# PC pairing (MCP pc_run_shell). Agent registers then polls; no shell on the app host.
# MIND_PC_PAIRING_SECRET=
# Legacy push agent (optional):
# MIND_PC_AGENT_URL=
# MIND_PC_AGENT_TOKEN=
