{
  "name": "Adrian's Mind Command OS — GitHub Tool Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "bash tools/bootstrap/install-github-workspace.sh",
  "postStartCommand": "bash tools/bootstrap/verify-github-workspace.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.vscode-github-actions",
        "GitHub.copilot"
      ]
    }
  },
  "remoteEnv": {
    "MIND_COMMAND_TOOLS_ROOT": "${containerWorkspaceFolder}/.tools",
    "PATH": "${containerWorkspaceFolder}/.tools/npm/bin:${containerEnv:PATH}"
  }
}
