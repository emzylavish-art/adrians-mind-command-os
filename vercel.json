{
  "git": {
    "deploymentEnabled": {
      "fix/image-generation-receipts-20261127": false
    }
  },
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/signup",
      "destination": "/login?mode=sign-up",
      "permanent": false
    },
    {
      "source": "/downloads/AdriansMind-Setup.exe",
      "destination": "https://github.com/emzylavish-art/adrians-mind-command-os/releases/tag/desktop-installer",
      "permanent": false
    },
    {
      "source": "/downloads/AdriansMind-Setup-Full.exe",
      "destination": "https://github.com/emzylavish-art/adrians-mind-command-os/releases/tag/desktop-installer",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!apps/(?:social|gpt-wrapper)/index\\.html$).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/apps/social/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/apps/gpt-wrapper/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
