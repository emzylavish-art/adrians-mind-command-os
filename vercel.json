{
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/signup",
      "destination": "/login?mode=sign-up",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
